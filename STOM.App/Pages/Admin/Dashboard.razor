@page "/admin/dashboard"
@inject ApiService apiService
@inject AuthService authService

@if (authService.CurrentRole != "Admin" && authService.CurrentRole != "SuperAdmin")
{
    <div class="alert alert-danger">
        <p>Access Denied. Admin role required.</p>
        <a href="/" class="btn btn-sm btn-secondary">Back to Home</a>
    </div>
}
else
{
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-10 mx-auto">
                <h2>Tournament Dashboard</h2>
                <p class="text-muted">Role: @authService.CurrentRole</p>

                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Active Games</h5>
                    </div>
                    <div class="card-body">
                        @if (games?.Count > 0)
                        {
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Game Name</th>
                                        <th>Score Count</th>
                                        <th>Average Score</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var game in games)
                                    {
                                        <tr>
                                            <td>@game.Name</td>
                                            <td>@game.Scores?.Count</td>
                                            <td>@(game.Scores?.Count > 0 ? game.Scores.Average(s => s.Value).ToString("F2") : "N/A")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted">No games found.</p>
                        }
                    </div>
                </div>

                <div class="mt-3">
                    <a href="/" class="btn btn-secondary">Back to Home</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Game>? games;

    protected override async Task OnInitializedAsync()
    {
        games = await apiService.GetAllGamesAsync();
    }
}
