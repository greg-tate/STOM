@page "/superadmin/console"
@inject AdminApiService adminApiService
@inject AuthService authService

@if (authService.CurrentRole != "SuperAdmin")
{
    <div class="alert alert-danger">
        <p>Access Denied. SuperAdmin role required.</p>
        <a href="/" class="btn btn-sm btn-secondary">Back to Home</a>
    </div>
}
else
{
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-10 mx-auto">
                <h2>Admin Console</h2>
                <p class="text-muted">SuperAdmin Role - Full Audit Access</p>

                <ul class="nav nav-tabs mb-4" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "create" ? "active" : "")" href="javascript:void(0)" @onclick="@(() => SetTab("create"))">
                            Create Competition
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "audit" ? "active" : "")" href="javascript:void(0)" @onclick="@(() => SetTab("audit"))">
                            Audit Logs
                        </a>
                    </li>
                </ul>

                @if (activeTab == "create")
                {
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Create New Competition</h5>
                            <form @onsubmit="CreateCompetition">
                                <div class="mb-3">
                                    <label for="name" class="form-label">Competition Name</label>
                                    <input type="text" class="form-control" id="name" @bind="competitionName" />
                                </div>
                                <div class="mb-3">
                                    <label for="date" class="form-label">Date</label>
                                    <input type="date" class="form-control" id="date" @bind="competitionDate" />
                                </div>
                                <button type="submit" class="btn btn-primary">Create</button>
                            </form>
                        </div>
                    </div>
                }
                else if (activeTab == "audit")
                {
                    <div class="card">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h5 class="mb-0">Audit Log</h5>
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="RefreshAuditLog">Refresh</button>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (auditLogs?.Count > 0)
                            {
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Timestamp</th>
                                            <th>Action</th>
                                            <th>Performed By</th>
                                            <th>Details</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var log in auditLogs)
                                        {
                                            <tr>
                                                <td>@log.Timestamp.ToString("g")</td>
                                                <td>@log.Action</td>
                                                <td>@log.PerformedBy</td>
                                                <td>@log.Details</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="text-muted">No audit logs found.</p>
                            }
                        </div>
                    </div>
                }

                <div class="mt-3">
                    <a href="/" class="btn btn-secondary">Back to Home</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "create";
    private string competitionName = "";
    private DateTime competitionDate = DateTime.Today;
    private List<AuditLog>? auditLogs;

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private async Task CreateCompetition()
    {
        var req = new CompetitionRequest { Name = competitionName, Date = competitionDate };
        await adminApiService.CreateCompetitionAsync(req);
        competitionName = "";
        competitionDate = DateTime.Today;
        await RefreshAuditLog();
    }

    private async Task RefreshAuditLog()
    {
        auditLogs = await adminApiService.GetAuditLogsAsync(DateTime.Now.AddDays(-1));
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshAuditLog();
    }
}
