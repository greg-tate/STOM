@page "/score/{GameId:int}"
@inject ApiService apiService
@inject SyncService syncService
@inject AuthService authService

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <h2>@game?.Name</h2>
            <p class="text-muted">Game ID: @GameId</p>

            @if (game != null)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Enter Score</h5>
                        <form @onsubmit="SubmitScore">
                            <div class="mb-3">
                                <label for="score" class="form-label">Score Value</label>
                                <input type="number" class="form-control" id="score" @bind="enteredScore" />
                            </div>
                            <button type="submit" class="btn btn-primary">Submit Score</button>
                        </form>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Recent Scores</h5>
                    </div>
                    <div class="card-body">
                        @if (game.Scores?.Count > 0)
                        {
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Value</th>
                                        <th>Submitted</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var score in game.Scores.OrderByDescending(s => s.CreatedAt))
                                    {
                                        <tr>
                                            <td>@score.Value</td>
                                            <td>@score.CreatedAt.ToShortTimeString()</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted">No scores yet.</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-danger">Game not found</div>
            }

            <div class="mt-3">
                <a href="/" class="btn btn-secondary">Back to Home</a>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int GameId { get; set; }

    private Game? game;
    private int enteredScore;

    protected override async Task OnInitializedAsync()
    {
        game = await apiService.GetGameAsync(GameId);
    }

    private async Task SubmitScore()
    {
        if (game == null) return;

        var result = await apiService.AddScoreAsync(GameId, enteredScore);
        if (result != null)
        {
            game.Scores.Add(result);
            enteredScore = 0;
        }
    }
}
