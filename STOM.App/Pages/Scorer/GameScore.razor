@page "/score/{GameId:int}"
@inject ApiService apiService
@inject SyncService syncService
@inject AuthService authService
@inject OfflineCapabilityService offlineCapabilityService

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <h2>@game?.Name</h2>
            <p class="text-muted">Game ID: @GameId</p>

            @if (game != null)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Enter Score</h5>
                        @if (offlineCapabilityService.IsOffline)
                        {
                            <div class="alert alert-warning mb-3">
                                📡 You are offline. Scores will be queued and synced when connection is restored.
                            </div>
                        }
                        <form @onsubmit="SubmitScore">
                            <div class="mb-3">
                                <label for="score" class="form-label">Score Value</label>
                                <input type="number" class="form-control" id="score" @bind="enteredScore" />
                            </div>
                            <button type="submit" class="btn btn-primary">
                                @(offlineCapabilityService.IsOffline ? "Submit (Offline)" : "Submit Score")
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Recent Scores</h5>
                            @if (offlineCapabilityService.IsOnline && SyncStatus != null)
                            {
                                <small class="text-muted">@SyncStatus</small>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        @if (game.Scores?.Count > 0)
                        {
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Value</th>
                                        <th>Submitted</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var score in game.Scores.OrderByDescending(s => s.CreatedAt))
                                    {
                                        <tr class="@(score.IsPending ? "table-warning" : "")">
                                            <td>@score.Value</td>
                                            <td>@score.CreatedAt.ToShortTimeString()</td>
                                            <td>
                                                @if (score.IsPending)
                                                {
                                                    <span class="badge bg-warning">⏳ Pending</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">✓ Synced</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted">No scores yet.</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-danger">Game not found</div>
            }

            <div class="mt-3">
                <a href="/" class="btn btn-secondary">Back to Home</a>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int GameId { get; set; }

    private Game? game;
    private int enteredScore;
    private string? SyncStatus;

    protected override async Task OnInitializedAsync()
    {
        game = await apiService.GetGameAsync(GameId);

        apiService.SyncStatusChanged += (s, msg) =>
        {
            SyncStatus = msg;
            StateHasChanged();
        };

        offlineCapabilityService.OnlineStatusChanged += async (s, isOnline) =>
        {
            if (isOnline)
            {
                game = await apiService.GetGameAsync(GameId);
                StateHasChanged();
            }
        };
    }

    private async Task SubmitScore()
    {
        if (game == null) return;

        var result = await apiService.AddScoreAsync(GameId, enteredScore);
        if (result != null)
        {
            game.Scores.Add(result);
            enteredScore = 0;

            if (offlineCapabilityService.IsOnline)
            {
                await Task.Delay(500);
                game = await apiService.GetGameAsync(GameId);
            }
        }
    }
}
