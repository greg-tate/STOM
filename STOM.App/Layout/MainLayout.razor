@inherits LayoutComponentBase
@inject OfflineCapabilityService OfflineCapabilityService
@inject SyncService SyncService
@inject IJSRuntime JSRuntime

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="d-flex justify-content-between align-items-center w-100">
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                <a href="http://localhost:5022/swagger/index.html" target="_blank">Swagger UI</a>
                <a href="http://localhost:5022/openapi/v1.json" target="_blank">Scalar API</a>
                <div class="sync-indicator">
                    <span class="@StatusClass" title="@StatusTitle">
                        @if (OfflineCapabilityService.IsOffline)
                        {
                            <span class="badge bg-warning">🌐 Offline</span>
                        }
                        else
                        {
                            <span class="badge bg-success">🌐 Online</span>
                        }
                    </span>
                    @if (PendingCount > 0)
                    {
                        <span class="badge bg-info ms-2" title="Pending scores to sync">
                            📤 @PendingCount pending
                        </span>
                        <button class="btn btn-sm btn-primary ms-2" @onclick="SyncNow">Sync Now</button>
                    }
                    @if (!string.IsNullOrEmpty(SyncStatus))
                    {
                        <small class="text-muted ms-2">@SyncStatus</small>
                    }
                </div>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private int PendingCount = 0;
    private string SyncStatus = string.Empty;
    private string StatusClass = string.Empty;
    private string StatusTitle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        PendingCount = SyncService.GetPendingCount();

        SyncService.SyncStatusChanged += (s, msg) =>
        {
            SyncStatus = msg;
            PendingCount = SyncService.GetPendingCount();
            StateHasChanged();
        };

        OfflineCapabilityService.OnlineStatusChanged += (s, isOnline) =>
        {
            Console.WriteLine($"[DEBUG] OnlineStatusChanged: {isOnline}");
            UpdateStatus();
            StateHasChanged();
        };

        UpdateStatus();
        await base.OnInitializedAsync();
        
        // Defer heavy initialization to background - doesn't block render
        _ = Task.Run(async () =>
        {
            try
            {
                await OfflineCapabilityService.InitializeAsync();
                Console.WriteLine($"[DEBUG] InitializeAsync: OfflineCapabilityService initialized");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ERROR] InitializeAsync failed: {ex.Message}");
            }
        });
    }

    private void UpdateStatus()
    {
        StatusClass = OfflineCapabilityService.IsOnline ? "text-success" : "text-warning";
        StatusTitle = OfflineCapabilityService.IsOnline ? "Connected to network" : "No network connection";
    }

    private async Task SyncNow()
    {
        SyncStatus = "Syncing...";
        await SyncService.TrySyncAsync();
    }
}

<style>
    .sync-indicator {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
</style>

