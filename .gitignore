## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio cache/options directory
.vs/
.vscode/

# Build results
bin/
obj/
*.dll
*.exe
*.pdb

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/
*.code-workspace

# Local database
*.mdf
*.ldf
*.ndf

# NuGet
*.nupkg
*.snupkg
packages/

# dotnet build output
.dotnet/

# Editor directories and files
.idea/
.DS_Store
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Miscellaneous
*.class
*.log
*.pot
*.rej
*.swo
*.swp
*.zip
*.gz
*.rar
